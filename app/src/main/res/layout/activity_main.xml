<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:background="@color/paper">

    <!-- Header Mobile (Sidebar.tsx) -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:background="@color/paper">

        <TextView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_button_ink"
                android:gravity="center"
                android:text="R"
                android:textColor="@color/lime"
                android:textSize="16sp"
                android:textStyle="bold" />

        <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="rumo"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/btnHeaderCalendar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/nav_calendar"
                android:gravity="center"
                android:text="📅"
                android:textColor="@color/ink"
                android:textSize="15sp" />

        <TextView
                android:id="@+id/btnHeaderMaterials"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/nav_materials"
                android:gravity="center"
                android:text="📚"
                android:textColor="@color/ink"
                android:textSize="15sp" />

        <TextView
                android:id="@+id/btnHeaderForum"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/nav_forum"
                android:gravity="center"
                android:text="💬"
                android:textColor="@color/ink"
                android:textSize="15sp" />

        <TextView
                android:id="@+id/btnHeaderPerformance"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/nav_performance"
                android:gravity="center"
                android:text="📊"
                android:textColor="@color/ink"
                android:textSize="15sp" />

        <TextView
                android:id="@+id/btnHeaderConfig"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/ink"
                android:textSize="17sp" />
    </LinearLayout>

    <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

    <!-- Container onde as telas (Fragments) são carregadas -->
    <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    <!-- Barra de Navegação Inferior Flutuante (Sidebar.tsx) -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_margin="12dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="6dp">

        <TextView
                android:id="@+id/navPainel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Painel"
                android:textColor="@color/lime"
                android:textSize="11sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/navEstudo"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Estudar"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

        <TextView
                android:id="@+id/navPlano"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Meu plano"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

        <TextView
                android:id="@+id/navSimulados"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Simulados"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />

        <TextView
                android:id="@+id/navRanking"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Ranking"
                android:textColor="#99FFFFFF"
                android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>