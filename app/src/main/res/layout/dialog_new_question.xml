<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="FÓRUM DA COMUNIDADE"
        android:textColor="@color/accent"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Nova dúvida"
        android:textColor="@color/ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtQuestionTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_input"
        android:hint="Resumo da dúvida (Ex.: Dúvida em Estequiometria)"
        android:inputType="textCapSentences"
        android:paddingHorizontal="14dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/edtQuestionBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input"
        android:gravity="top|start"
        android:hint="Explique o contexto da questão ou conceito..."
        android:inputType="textMultiLine|textCapSentences"
        android:minHeight="110dp"
        android:padding="14dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/muted"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Vestibular"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerQuestionExam"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input"
        android:paddingHorizontal="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Disciplina"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerQuestionSubject"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input"
        android:paddingHorizontal="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelQuestion"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="@string/dialog_cancel"
            android:textAllCaps="false"
            android:textColor="@color/muted" />

        <Button
            android:id="@+id/btnPublishQuestion"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/accent"
            android:text="Publicar dúvida"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
