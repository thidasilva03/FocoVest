<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/paper"
            android:scrollbars="none">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <!-- Data e Saudação -->
        <TextView
                android:id="@+id/txtDateEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SÁBADO, 14 DE NOVEMBRO"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

        <TextView
                android:id="@+id/txtGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Bom dia, Estudante."
                android:textColor="@color/ink"
                android:textSize="26sp"
                android:textStyle="bold" />

        <TextView
                android:id="@+id/txtSubtitleMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Modo autônomo · Plano do edital"
                android:textColor="@color/muted"
                android:textSize="13sp" />

        <!-- Grade 2x2 de Estatísticas -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

            <!-- Card 1: Pontos (Escuro) -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card_dark"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:id="@+id/txtStatPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.180"
                        android:textColor="@color/lime"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Pontos na semana"
                        android:textColor="#99FFFFFF"
                        android:textSize="12sp" />
            </LinearLayout>

            <!-- Card 2: Posição no Amazonas -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:id="@+id/txtStatRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12º"
                        android:textColor="@color/ink"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Posição no Amazonas"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

            <!-- Card 3: Acertos em fixação -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:id="@+id/txtStatFixacao"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textColor="@color/ink"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Acertos em fixação"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
            </LinearLayout>

            <!-- Card 4: Simulados feitos -->
            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:id="@+id/txtStatSimulados"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/ink"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Simulados feitos"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card Destaque: Continuar Estudando -->
        <LinearLayout
                android:id="@+id/cardContinueTopic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_button_accent"
                android:orientation="vertical"
                android:padding="22dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONTINUAR ESTUDANDO"
                    android:textColor="#CCFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

            <TextView
                    android:id="@+id/txtLastTopicTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Função do 2º grau"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/txtLastTopicSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Vértice, raízes, concavidade e problemas de máximo e mínimo."
                    android:textColor="#D9FFFFFF"
                    android:textSize="14sp" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="10dp"
                    android:text="Videoaula, anotações e exercícios →"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <!-- Card: Hoje no seu plano -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

            <TextView
                    android:id="@+id/txtTodayPlanHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hoje no seu plano"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            <LinearLayout
                    android:id="@+id/pendingTopicsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            <TextView
                    android:id="@+id/btnSeeFullPlan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Ver plano completo →"
                    android:textColor="@color/accent"
                    android:textSize="13sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <!-- Card: Desempenho por disciplina -->
        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Desempenho por disciplina"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            <LinearLayout
                    android:id="@+id/subjectAccuracyContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />
        </LinearLayout>

        <!-- Card Atalho: Simulado Sugerido -->
        <LinearLayout
                android:id="@+id/cardSuggestedSimulado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_pill_lime"
                android:orientation="vertical"
                android:padding="20dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SIMULADO SUGERIDO"
                    android:textColor="#9916181D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/txtSuggestedSimName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="PSC · Conhecimentos Gerais"
                    android:textColor="@color/ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/txtSuggestedSimMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="12 questões · 40 min"
                    android:textColor="#B316181D"
                    android:textSize="13sp" />
        </LinearLayout>

        <!-- Card Atalho: Ranking Amazonas -->
        <LinearLayout
                android:id="@+id/cardRankingShortcut"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_dark"
                android:orientation="vertical"
                android:padding="20dp">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RANKING AMAZONAS"
                    android:textColor="#80FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/txtRankingBannerPos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Você está em 12º"
                    android:textColor="@color/lime"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/txtRankingBannerLeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Líder: Ana Silva"
                    android:textColor="#99FFFFFF"
                    android:textSize="13sp" />
        </LinearLayout>

        <!-- Grade 2x2: Atalhos para novas ferramentas -->
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="EXPLORAR FERRAMENTAS"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

            <LinearLayout
                    android:id="@+id/cardShortcutCalendar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 Calendário"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Datas das provas e lembretes"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/cardShortcutMaterials"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📚 Materiais"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Flashcards, textos, livros e provas"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

            <LinearLayout
                    android:id="@+id/cardShortcutForum"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 Fórum"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tire dúvidas com a comunidade"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/cardShortcutPerformance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📊 Desempenho"
                        android:textColor="@color/ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Acertos, erros e histórico"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>